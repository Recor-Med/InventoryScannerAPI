# --- Server ---
PORT=8080
# Comma separated list of origins allowed to call this API (your scanner app's URL(s))
ALLOWED_ORIGINS=https://your-scanner-static-web-app.azurestaticapps.net,http://localhost:3000

# --- Salesforce integration user (username/password + security token flow) ---
# This is the simplest auth flow to get working with an "integration user"
# that has been given a username, password and security token.
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=integration.user@yourorg.com
SF_PASSWORD=yourPassword
SF_SECURITY_TOKEN=yourSecurityToken

# --- Salesforce object/field API names ---
# Adjust these if your org's custom object/field API names differ.
SF_ACCOUNT_OBJECT=Account
SF_ACCOUNT_NUMBER_FIELD=AccountNumber
SF_WAREHOUSE_CODE_FIELD=cr5bd_warehousecode__c

SF_ITEM_OBJECT=cr5bd_inventoryitem__c
SF_ID_OBJECT=cr5bd_productid__c

# --- Salesforce Flow (optional) triggered by /api/submit ---
# If set, POST /api/submit will invoke this Flow/REST endpoint with the payload.
SF_SUBMIT_FLOW_API_NAME=
