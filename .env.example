# --- Server ---
PORT=8080
# Comma separated list of origins allowed to call this API (your scanner app's URL(s))
ALLOWED_ORIGINS=https://your-scanner-static-web-app.azurestaticapps.net,http://localhost:3000

# --- Salesforce integration user (OAuth 2.0 JWT Bearer flow) ---
# This uses a Connected App + digital certificate instead of a password and
# security token. No password/token is required, and it works regardless of
# the calling server's IP address. See README.md for the Connected App setup
# steps.
SF_LOGIN_URL=https://test.salesforce.com
SF_USERNAME=integration.user@yourorg.com.full
# Consumer Key from the Salesforce Connected App
SF_CLIENT_ID=yourConnectedAppConsumerKey
# The private key (PEM) matching the certificate uploaded to the Connected
# App. Either paste the full PEM contents here (with \n for newlines if set
# as a single-line value, e.g. via Azure App Settings / Key Vault), or set
# SF_JWT_PRIVATE_KEY_PATH to a file path instead.
SF_JWT_PRIVATE_KEY=
SF_JWT_PRIVATE_KEY_PATH=

# --- Salesforce object/field API names ---
# Adjust these if your org's custom object/field API names differ.
SF_ACCOUNT_OBJECT=Account
SF_ACCOUNT_NUMBER_FIELD=Recor_Account_Number__c

SF_ITEM_OBJECT=cr5bd_inventoryitem__c
SF_ID_OBJECT=cr5bd_productid__c

# --- Salesforce Flow (optional) triggered by /api/submit ---
# If set, POST /api/submit will invoke this Flow/REST endpoint with the payload.
SF_SUBMIT_FLOW_API_NAME=
